title Detailed Checkout Process

// Define actors with icons and colors
User [icon: user, color: green]
Browser [icon: globe, color: blue]
Server [icon: server, color: red]
StripeAPI [icon: credit-card, color: purple]

// User initiates the checkout process
User > Browser: Selects items and proceeds to checkout
activate User
activate Browser

// Browser requests payment intent creation from Server
Browser > Server: POST /create-payment-intent with item details
activate Server

// Server calculates order amount and requests Stripe to create a payment intent
Server > StripeAPI: Create PaymentIntent
activate StripeAPI
StripeAPI > Server: PaymentIntent with clientSecret
deactivate StripeAPI

// Server responds back to Browser with clientSecret
Server > Browser: Response with clientSecret
deactivate Server

// Browser sets up Stripe Elements
Browser > Browser: Setup Stripe Elements with clientSecret
opt [label: "If 3D Secure required"] 
{
    Browser > User: Request 3D Secure authentication
    User > Browser: Completes 3D Secure authentication
}

// User submits payment through Stripe Elements
User > Browser: Submits payment
Browser > StripeAPI: Confirm Payment
activate StripeAPI
alt [label: "Payment successful", color: green] 
{
    StripeAPI > Browser: Payment confirmation
    Browser > User: Display success message
}
else [label: "Payment failed", color: red] 
{
    StripeAPI > Browser: Error message
    Browser > User: Display error and ask to retry
}
deactivate StripeAPI
deactivate Browser
deactivate User
